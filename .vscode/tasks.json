{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "live:go",
      "type": "shell",
      "command": "node scripts/live-go.mjs",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Vite (já lê src/|pronto)|built in|watching for changes"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
