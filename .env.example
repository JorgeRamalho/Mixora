# URL pública do site (usada nos links de confirmação de e-mail)
SITE_URL=https://mamute-djplayer.netlify.app

# Netlify Database (GA) — injetado no deploy e via `netlify dev` / `netlify database connect`
# NETLIFY_DB_URL=postgresql://...
# Limpar todos os usuários DJ: npm run db:reset-users (local + production)
# Apenas um ambiente: npm run db:purge-users ou npm run db:purge-users:production

# Fallback opcional (legado ou Postgres externo)
# NETLIFY_DATABASE_URL=postgresql://...
# DATABASE_URL=postgresql://...

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# MusicDiscover — biblioteca de faixas da cabine (discover ui --port 8765)
VITE_TRACKS_API_MODE=live
VITE_TRACKS_API_BASE=http://127.0.0.1:8765
