{
  "name": "projeto-mamute-djplayerm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/bootstrap.mjs --migrate",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:api": "netlify dev",
    "bootstrap": "node scripts/bootstrap.mjs --migrate",
    "bootstrap:check": "node scripts/bootstrap.mjs --check-only",
    "resend:configure": "node scripts/configure-resend.mjs",
    "build": "tsc -b && vite build",
    "live": "tsc -b && vite build && vite preview --host --port 5500",
    "live:go": "node scripts/live-go.mjs",
    "live:vite": "node scripts/ensure-vite.mjs",
    "live:build": "tsc -b && vite build",
    "live:sync": "tsc -b && vite build && vite build --watch",
    "live:watch": "vite build --watch",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify database migrations apply",
    "db:repair": "node scripts/repair-local-database.mjs",
    "db:purge-users": "node scripts/purge-dj-users.mjs",
    "db:purge-users:production": "node scripts/purge-dj-users.mjs --target=production",
    "db:purge-users:all": "node scripts/purge-all-databases.mjs",
    "db:verify-users": "node scripts/verify-no-dj-users.mjs",
    "db:verify-users:production": "node scripts/verify-no-dj-users.mjs --target=production",
    "db:reset-users": "node scripts/purge-all-databases.mjs",
    "test": "npm run test:unit && playwright test --config config/playwright.config.ts",
    "test:unit": "vitest run --config config/vitest.config.ts",
    "test:auth": "playwright test --config config/playwright.config.ts tests/e2e/dj-auth-flow.spec.ts --project=desktop-chrome",
    "test:live": "playwright test --config config/playwright.live.config.ts tests/e2e/live-src.spec.ts tests/e2e/live-server.spec.ts",
    "test:ui": "playwright test --ui --config config/playwright.config.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@netlify/database": "^2.0.0",
    "@netlify/functions": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "netlify-cli": "^27.4.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
